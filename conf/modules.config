/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'CREATE_SAMPLESHEET' {
        // This process gates the whole run: it exits 1 with a [FIX] message naming the
        // samples whose taxonomy did not resolve. Ignoring that leaves every downstream
        // subworkflow with an empty channel, so the run "succeeds" having assembled
        // nothing. Stop immediately instead.
        errorStrategy = 'terminate'
        publishDir = [
        path: { "${params.outdir}/samplesheet" },
        mode: params.publish_dir_mode
        ]
    }

    withName: 'TRIGGER_MITOGENOME' {
        publishDir = [
        path: { "${params.mitogenome_nfcore_dir}" },
        mode: params.publish_dir_mode
        ]
    }

    withName: 'BASESPACE' {
        publishDir = [
          path: { "${params.outdir}/basespace/${params.run}" },
          mode: params.publish_dir_mode
        ]
    }

    withName: 'BBMAP_REPAIR' {
        publishDir = [
          path: { "${params.outdir}/pooled/${params.run}" },
          mode: params.publish_dir_mode
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/fastp/fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.tool_params_mqcrow.html') ? null : filename }
        ]
    }

    withName: FASTP {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/fastp" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.tool_params_mqcrow.html') ? null : filename }
        ]
    }

    withName: TRIGGER_MITOGENOME {
        publishDir = [
            path: { "${params.mitogenome_nfcore_dir}" },
            mode: params.publish_dir_mode,
        ]
    }
    
    withName: KRAKEN2_KRAKEN2 {
        // --confidence matters here. At kraken2's default of 0 a single matching k-mer
        // assigns a read, which for hosts the database covers poorly (sponges,
        // deep-sea crustaceans) throws away real host sequence.
        ext.args = { "--confidence ${params.kraken2_confidence}" }
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/kraken2" },
            mode: params.publish_dir_mode,
            // The per-read assignment file is roughly one line per read pair. It is
            // needed only by KRAKENTOOLS_EXTRACTREADS, so keep it in the work dir.
            saveAs: { filename -> filename.contains('classifiedreads') ? null : filename }
        ]
    }

    withName: KRAKENTOOLS_EXTRACTREADS {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/kraken2" },
            mode: params.publish_dir_mode,
            // The filtered reads are an intermediate: megahit and meryl consume them
            // from the work dir, and fastp's reads are already published.
            saveAs: { filename ->
                (filename.endsWith('.fastq.gz') || filename.endsWith('_mqc.yaml')) ? null : filename
            }
        ]
    }

    withName: MERYL_COUNT {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/kmers" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: MERYL_UNIONSUM {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/kmers" },
            mode: params.publish_dir_mode
        ]
    }

    withName: MERYL_HISTOGRAM {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/kmers" },
            mode: params.publish_dir_mode
        ]
    }

    withName: GENOMESCOPE2 {
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/kmers/${meta.prefix}.genomescope" },
            mode: params.publish_dir_mode
        ]
        // Define dynamic args and prefix based on params, if the --genomescope2_l parameter is set it will add in the -l flag and append to the output prefix
        // The -l flag value can be set in the nextflow_run.sh script
        // Examples: --genomescope2_l "10" or --genomescope2_l false
        // If false or not set, it will run without the -l flag
        // -m/--max_kmercov excludes k-mers above the cutoff from the model fit. At the
        // old hard-coded 1000 this discarded 25-79% of the total k-mer mass on
        // repeat-rich invertebrates (crustaceans, molluscs, sponges), which broke the
        // fit and biased Genome Haploid Length downward by up to 10x.
        ext.args = { 
            def args = "-k ${params.kvalue ?: 21} -m ${params.genomescope2_m}"
            def extra_flags = params.genomescope2_l ? 
                "-l ${params.genomescope2_l}" : ''
            return "${args} ${extra_flags}".trim()
        }
        ext.prefix = { 
            def suffix = params.genomescope2_l ? 
                ".l${params.genomescope2_l}" : ''
            return "${meta.prefix}_genomescope2${suffix}"
        }
    }

    withName: CALCULATE_SEQUENCING_COVERAGE {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/coverage" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_coverage_summary_mqc.yaml') ? null : filename }
        ]
    }

    withName: COMPILE_JSON_TO_CSV {
        publishDir = [
            path: { "${params.outdir}/coverage_summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('_mqc.yaml')) ? null : filename }
        ]
        ext.prefix = { "genome_coverage_summary" }
    }

    withName: MEGAHIT {
        ext.args = ''
        // Anything added to ext.args here that changes the assembly changes the
        // checkpoint fingerprint, so existing checkpoints are rebuilt rather than
        // reused. -m/-t are excluded from the fingerprint: they vary per retry and
        // do not change the contigs.
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome" },
            mode: params.publish_dir_mode
        ]
    }

    withName: FCSGX_RUNGX {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome/NCBI" },
            mode: params.publish_dir_mode
        ]
    }

    withName: FCSGX_CLEANGENOME {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome/NCBI" },
            mode: params.publish_dir_mode
        ]
    }

    withName: BBMAP_FILTERBYNAME{
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome/NCBI" },
            mode: params.publish_dir_mode
        ]
    }

    withName: BBMAP_REFORMAT {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome" },
            mode: params.publish_dir_mode
        ]
    }

    withName: FCS_FCSADAPTOR {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome/NCBI/adaptor" },
            mode: params.publish_dir_mode
        ]
    }

    withName: FSCSGX_CLEANGENOME_ADAPTOR {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome" },
            mode: params.publish_dir_mode
        ]
    }

    withName: TIARA_TIARA {
        // tiara defaults to --min_len 3000, which on these megahit short-read
        // assemblies (N50 665-2500 bp) left 40-99% of the sequence unscreened and
        // opened a 1-3 kb gap that FCS-GX REVIEW contigs fell straight through.
        ext.args = "--min_len ${params.tiara_min_len}"
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome/tiara" },
            mode: params.publish_dir_mode
        ]
    }

    withName: BBMAP_FILTERBYNAME_TIARA {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome" },
            mode: params.publish_dir_mode
        ]
    }

    withName: BUSCO_BUSCO {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome/busco" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.tool_params_mqcrow.html') ? null : filename }
        ]
    }
    withName: 'EXTRACT_BUSCO_SEQUENCES' {
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome/busco/busco_sequences" },
            mode: 'copy'
        ]
    }
    
    withName: BWAMEM2_INDEX {
        publishDir = [enabled: false]
    }

    withName: BWAMEM2_MEM {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome/bwa" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.tool_params_mqcrow.html') ? null : filename }
        ]
    }
    
    withName: MERQURY_MERQURY {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/kmers" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.tool_params_mqcrow.html') ? null : filename }
        ]
    }
    
    withName: GFASTATS {
        ext.args = '--nstar-report'
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome/gfastats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.tool_params_mqcrow.html') ? null : filename }
        ]
    }

    withName: SEQKIT_STATS {
        ext.args = '--all'
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/assemblies/genome/seqkit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.tool_params_mqcrow.html') ? null : filename }
        ]
    }

    withName: GETORGANELLE_FROMREADS {
        ext.args = '-R 10 -w 95 --continue'
        publishDir = [
            path: { "${params.outdir}/mitogenomes/${meta.id}/${meta.mt_assembly_prefix}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: EMMA {
        ext.args = '--rotate MT-TF'
        publishDir = [
            path: { "${params.outdir}/mitogenomes/${meta.id}/${meta.mt_assembly_prefix}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: BLAST_BLASTN {
        ext.args = [
                '-outfmt "6 qseqid sseqid staxids sscinames scomnames sskingdoms pident length qlen slen mismatch gapopen gaps qstart qend sstart send stitle evalue bitscore qcovs qcovhsp"',
                '-num_alignments 999999',
                '-evalue 1',
                '-task blastn',
            ].join(' ')
        publishDir = [
            path: { "${params.outdir}/mitogenomes/${meta.id}/${meta.mt_assembly_prefix}/lca" },
            mode: params.publish_dir_mode
        ]
    }

    withName: LCA {
        publishDir = [
            path: { "${params.outdir}/mitogenomes/${meta.id}/${meta.mt_assembly_prefix}/lca" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC_PER_SAMPLE' {
        ext.args   = {
            def title = params.multiqc_title ? "${params.multiqc_title} - ${meta.id}" : "${meta.id}"
            return "--title \"$title\""
        }
        publishDir = [
            path: { "${params.outdir}/draftgenomes/${meta.id}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Per-sample tolerance.
    //
    // conf/base.config fails the run on any non-zero exit that is not a resource
    // kill, so that a broken samplesheet or a failed aggregation cannot be mistaken
    // for a successful run. These modules operate on one genome at a time, where a
    // single failure should cost that genome and not the other 79, so they keep the
    // tolerant behaviour explicitly. Anything not listed here -- CREATE_SAMPLESHEET,
    // DOWNLOAD_TAXONKIT_DB, BASESPACE, COMPILE_JSON_TO_CSV, MULTIQC -- is run-level
    // and stops the run when it fails.
    withName: 'BBMAP_REPAIR|FASTQC|FASTP|KRAKEN2_KRAKEN2|KRAKENTOOLS_EXTRACTREADS|MERYL_COUNT|MERYL_UNIONSUM|MERYL_HISTOGRAM|GENOMESCOPE2|CALCULATE_SEQUENCING_COVERAGE|MEGAHIT|FCSGX_RUNGX|FCSGX_CLEANGENOME|BBMAP_FILTERBYNAME|FCS_FCSADAPTOR|FSCSGX_CLEANGENOME_ADAPTOR|TIARA_TIARA|BBMAP_FILTERBYNAME_TIARA|BUSCO_BUSCO|EXTRACT_BUSCO_SEQUENCES|BWAMEM2_INDEX|BWAMEM2_MEM|MERQURY_MERQURY|GFASTATS|SEQKIT_STATS|PUSH_FASTP_RESULTS|PUSH_ASSEMBLY_RESULTS|PUSH_DECONTAMINATION_RESULTS|PUSH_BUSCO_RESULTS|PUSH_MERQURY_RESULTS|PUSH_GFA_RESULTS|MULTIQC_PER_SAMPLE|TRIGGER_MITOGENOME' {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 247) && task.attempt <= (task.maxRetries ?: 0) ? 'retry' : 'ignore' }
    }
}
