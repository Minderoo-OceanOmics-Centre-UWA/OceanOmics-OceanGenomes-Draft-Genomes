/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/oceangenomesdraftgenomes Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // Process defaults tuned for oceangenomesdraftgenomes; override in custom configs as needed.
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    maxRetries    = 2
    // Resource kills (signals, OOM, walltime) are retried at a larger size and then
    // tolerated, because losing one genome of an 80-sample run to a node limit should
    // not stop the other 79. Every other non-zero exit is a real tool error and must
    // stop the run: 'finish' lets the in-flight tasks drain and then exits non-zero so
    // post_draft.py and the poller see a failure. Per-sample modules that should still
    // tolerate a single bad genome are listed against `error_ignore` in modules.config.
    errorStrategy = {
        def retries = task.maxRetries ?: 0
        task.exitStatus in ((130..145) + 104 + 247) ?
            (task.attempt <= retries ? 'retry' : 'ignore') :
            'finish'
    }
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // Customise requirements for specific processes as needed below.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors

    withLabel:process_single {
        cpus    = { 1                   }
        memory  = { 6.GB * task.attempt }
        time    = { 4.h  * task.attempt }
    }
    // DB writes: a single psycopg2 insert. Measured at 12-17 s and <0.1 GB RSS,
    // so process_medium's 36 GB (42 billed cores on Setonix) and 8 h reservation
    // were pure scheduler drag. Matches the label of the same name in the
    // mitogenomes-inverts repo.
    withLabel:process_upload {
        cpus    = { 1                   }
        memory  = { 6.GB * task.attempt }
        time    = { 30.m * task.attempt }
    }
    withLabel:process_low {
        cpus    = { 2     * task.attempt }
        memory  = { 12.GB * task.attempt }
        time    = { 4.h   * task.attempt }
    }
    
    withLabel:process_medium {
        cpus    = { 6     * task.attempt }
        memory  = { 36.GB * task.attempt }
        time    = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus    = { 12    * task.attempt }
        memory  = { 72.GB * task.attempt }
        time    = { Math.min( 24, 16 * task.attempt ).h }
    }
    withLabel:process_extra_high {
        cpus    = 16
        memory  = 230.GB
        time    = { Math.min( 24, 16 * task.attempt ).h }
    }
    withLabel:process_long {
        time    = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        queue   = 'highmem'
        cpus    = 32
        memory  = { 512.GB * task.attempt }
        time    = { Math.min( 24, 16 * task.attempt ).h }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // Custome resourcing

    withName: 'FASTQC' {
        cpus = 6
        memory = '8 GB'
        time = '04:00:00'
    }
    
    withName: 'TRIGGER_MITOGENOME' {
        cpus    = 1
        memory  = '2 GB'
        time    = '00:30:00'
    }

    withName: 'BUSCO_BUSCO' {
        // change the second work queue to highmem and bump the second memory up to 960 if you have vert samples that are oom killed.
        // Actinopteri: always work queue with 60GB
        // Non-Actinopteri: work queue (230GB) -> highmem queue (960GB) on retry
        queue   = { 
            meta.class == 'Actinopteri' ? 'work' : (task.attempt == 1 ? 'work' : 'highmem')
        }
        cpus    = { meta.class == 'Actinopteri' ? 24 : 12 }
        memory  = { 
            meta.class == 'Actinopteri' ? 100.GB * task.attempt : (task.attempt == 1 ? 230.GB : 960.GB)
        }
        time    = { 8.h * task.attempt }
        maxRetries = 2
    }
    
    withName: 'MEGAHIT' {
        cpus    = { meta.class =='Actinopteri' ? 16 : 16 }
        memory  = { 
            meta.class == 'Actinopteri' ? 80.GB * task.attempt : Math.min( 230, 100 * task.attempt ).GB
        }
        time    = { Math.min( 24, 8 * task.attempt ).h }
        maxRetries = 2
    }

    withName: 'MERQURY_MERQURY' {
        cpus    = 32
        memory  = { 50.GB * task.attempt }
        time    = { 3.h * task.attempt }
    }

    withName: 'BWAMEM2_MEM' {
        cpus    = 16
        memory  = { (meta.class == 'Actinopteri' ? 48.GB : 96.GB   ) * task.attempt }
        time    = { (meta.class == 'Actinopteri' ? 16.h  : 16.h     ) }
    }

    withName: 'GFASTATS' {
        cpus    = 16
        memory  = 40.GB
        time    = 16.h
    }

    // kraken2 loads the whole database hash into RAM. pluspfp_20230605 is a 158 GB
    // hash.k2d, so anything below ~200 GB either OOMs or falls back to memory-mapping
    // and crawls. Retry on highmem rather than nudging the work-queue request.
    withName: 'KRAKEN2_KRAKEN2' {
        queue   = { task.attempt == 1 ? 'work' : 'highmem' }
        cpus    = 16
        memory  = { task.attempt == 1 ? 230.GB : 460.GB }
        time    = { Math.min( 24, 6 * task.attempt ).h }
        maxRetries = 2
    }

    // extract_kraken_reads.py holds the read identifiers it is filtering on in memory,
    // which for a whole library is tens of millions of strings.
    withName: 'KRAKENTOOLS_EXTRACTREADS' {
        cpus    = 4
        memory  = { 64.GB * task.attempt }
        time    = { Math.min( 24, 6 * task.attempt ).h }
        maxRetries = 2
    }

    // With --min_len lowered from tiara's default 3000 to 1000, tiara classifies far
    // more contigs: OG3037 in NOVA_260909_LA goes from ~4 k to ~1.6 M. Runtime and
    // memory scale with contig count, so process_medium is no longer enough.
    withName: 'TIARA_TIARA' {
        cpus    = 16
        memory  = { Math.min( 230, 64 * task.attempt ).GB }
        time    = { Math.min( 24, 8 * task.attempt ).h }
        maxRetries = 2
    }
}
