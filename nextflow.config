/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/oceangenomesdraftgenomes Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // TODO nf-core: Specify your pipeline's command line flags

    // Basespace download params
    // date                        = params.run.tokenize('_')[1]
    interleave                  = false
    pooled                      = "${params.outdir}/pooled/${params.run}"

    // Input options
    input                      = null
    curated_blast_db            = null                     // User must specify
    schema_input = "assets/schema_input.json"
    binddir = null
    genomescope2_l = false // Examples: "10", "15", false, null

    // GenomeScope2 -m/--max_kmercov: k-mers above this coverage are excluded from the
    // model fit.
    //
    // This was briefly raised to 10000 on the theory that 1000 truncated real host
    // k-mer mass on repeat-rich invertebrates. A sweep over 27 histograms
    // (scripts/rerun_NOVA_260909_LA/98_genomescope_m_sweep.sh) showed otherwise:
    //   - the size estimate never plateaus as the ceiling rises. It climbs monotonically
    //     (median 1.13x from 1000 to 10000, up to 1.81x), so there is no coverage above
    //     which the extra mass stops arriving and no principled place to stop. That is
    //     what a continuous contamination/error tail looks like, not a repeat structure.
    //   - the added mass lands entirely in Genome Repeat Length. Genome Unique Length,
    //     the component the model actually constrains, does not move.
    //   - the same +10000 change moved repeat length +54.8% on raw reads and -1.6% on
    //     kraken2-cleaned reads. Decontamination, not the ceiling, is the lever.
    //   - on the fishes -- the samples with good fits and a real k-mer peak -- 1000 puts
    //     the estimate just under the assembly size, where a short-read draft should sit.
    //     10000 pushes several above it.
    //   - one sample (OG3043) lost its fit entirely above 1000: kmercov collapsed from
    //     40.7 to 0.6 and the model fit from 88% to 34%.
    // Raise it only for a specific sample with evidence its genomic signal is truncated.
    genomescope2_m = 1000

    // tiara --min_len. tiara's own default is 3000, which leaves most of a fragmented
    // short-read assembly unclassified. 500 matches the pipeline's contig floor but
    // tiara's accuracy degrades on very short contigs, so 1000 is the working floor.
    tiara_min_len = 1000

    // Minimum GenomeScope "Model Fit" (percent) below which the genome size estimate is
    // flagged unreliable and coverage is not graded.
    //
    // Applied to the UPPER of the two values GenomeScope reports, which is the fit to the
    // modelled region. The lower value is a residual over whatever genomescope2_m
    // admitted and falls mechanically as that ceiling rises -- gating on it meant the
    // gate was measuring its own -m setting and flagged 57 of 64 samples, including ones
    // fitted at 98%. Across the sweep the upper value was identical to two decimal places
    // at every -m for 20 of 27 histograms, and moved only where the fit genuinely broke.
    genomescope_min_model_fit = 50

    // Maximum GenomeScope "bias" coefficient. A diploid k-mer spectrum does not need a
    // large bias term; a big one is the model buying agreement with a shape that is not a
    // genome (OG2983 fitted bias 37 at kmercov 569 for a 10.9 Mb "genome" and was graded
    // EXCELLENT). Clean fishes on this run sit between 1.0 and 3.1.
    genomescope_max_model_bias = 5

    // How far the observed k-mer histogram mode may sit from the kmercov GenomeScope
    // fitted before the size estimate is flagged. A mode at 1x or 2x kmercov is normal
    // (homozygous vs heterozygous peak), so this only catches a fit that landed on
    // something other than the genome -- usually a high-coverage repeat or symbiont
    // plateau.
    genomescope_max_peak_kmercov_ratio = 3

    // The same check from below: a fitted kmercov well ABOVE the observed mode means
    // GenomeScope fitted a coverage the histogram does not show.
    genomescope_min_peak_kmercov_ratio = 0.5

    // Coverage ceiling for k-mer peak detection. Deliberately independent of
    // genomescope2_m: tying the search range to the model's cutoff meant changing the
    // cutoff changed which mode was detected, and so changed the flag.
    genomescope_peak_search_max = 1000

    // How far the GenomeScope size estimate may sit from the decontaminated assembly
    // size before it is flagged. This is the only check that catches a model which
    // converged cleanly onto the wrong thing -- OG3037 fitted at 86% and estimated
    // 209 Mb against a 1.26 Gb assembly, and no fit statistic objected.
    genomescope_min_assembly_ratio = 0.3
    genomescope_max_assembly_ratio = 2.0

    // MEASURE_KMER_COVERAGE: haploid k-mer coverage measured from read depth over Complete
    // BUSCO genes, as an independent check on GenomeScope's fitted kmercov.
    //
    // MAPQ floor for that depth. 20 is safe rather than conservative: on NOVA_260909_LA,
    // depth at Q0 and Q20 agreed within 3% on every sample tested, fragmented invertebrate
    // assemblies included, so the filter is not what makes their depth look low.
    kmer_depth_min_mapq = 20

    // Fewer usable Complete BUSCOs than this and the mean is not worth reporting. A
    // sample falling below it is usually a sign that the BUSCO table and the BAM describe
    // different assemblies, which the module checks for explicitly.
    kmer_depth_min_regions = 20

    // How far GenomeScope's fitted kmercov may sit from the measured lambda before the
    // size estimate is flagged. A factor of two here is a factor of two in the genome
    // size, and it is the specific error the measurement exists to catch.
    //
    // 1.5 rather than 2.0 because 2.0 is the worst possible place for this boundary:
    // fitting the homozygous peak as heterozygous or the reverse is GenomeScope's
    // characteristic failure, so a threshold at exactly 2.0 sits on top of the most common
    // failure mode -- and four NOVA_260909_LA samples cluster just underneath it (OG3000
    // 1.99, OG2617 1.95, OG2648 1.95, OG3065 1.90). The eight independently trusted fits
    // agree with the measurement to within 8.3% (0.917-0.996), so 1.5 keeps a wide margin
    // over everything known to be right. Blast radius: eight samples newly flag, six of
    // them already unreliable for other reasons; only OG2617 and OG3065 change verdict.
    kmer_depth_max_ratio = 1.5

    // Below this measured lambda there is no host signal to model and no seed can rescue
    // the fit: seeds of 3-8 on such samples produced fits of 5-8% with non-finite genome
    // lengths. The finding for these samples is the coverage itself.
    kmer_depth_min_seedable = 5.0

    // Host genome size from per-contig read depth. The k-mer route to a genome size
    // collapses below about 10x host coverage -- of the 32 NOVA_260909_LA samples with
    // measured host lambda under 10, not one produced an estimate within 2x of its own
    // assembly -- and depth partitioning needs no k-mer peak.
    //
    // Multiplicative half-width of the host depth band: a contig counts as host when
    // host_depth / window <= meandepth <= host_depth * window. At 2.0 the clean control
    // OG2906 reproduces its GenomeScope size to 4% (344.6 Mb against 358.9 Mb).
    host_depth_window = 2.0

    // Contigs shorter than this are excluded from the partition entirely. At a few hundred
    // bases a mean depth is noise, and the contig would otherwise be assigned by it.
    host_depth_min_contig = 500

    // Refit GenomeScope seeded with the measured lambda when the first fit was flagged.
    genomescope_reseed_when_flagged = true

    // Points of model_fit_full a reseeded fit must gain before it replaces the original.
    // It must also move kmercov toward the measured lambda -- both, because a reseed that
    // lands on the measured coverage while the fit degrades has found a different optimum
    // rather than a better one.
    genomescope_min_reseed_fit_gain = 2

    // Subdirectory for the run-level aggregate reports (coverage_summary, multiqc).
    // Empty by default, so a normal whole-run launch publishes where it always has.
    //
    // The tier re-run scripts set it to the tier name. Those two outputs aggregate only
    // the samples in the running launch, so each tier's copy was always partial and
    // overwrote the last -- and with tiers running concurrently, two processes writing one
    // file at the same time gives a torn one. Per-tier subdirectories keep them apart;
    // regenerating a single run-wide set over all samples is an end-of-run step.
    report_subdir = ""

    // What to do with contigs FCS-GX marks REVIEW rather than EXCLUDE:
    //   exclude    - remove all of them (default)
    //   short-only - remove only those <= 1000 bp (behaviour before Sept 2026)
    //   keep       - retain them all
    // FCS-GX downgrades EXCLUDE to REVIEW when its confidence is low, which for taxa
    // the GX database covers poorly means most of the contamination it finds. Nothing
    // downstream reviews these, so the default removes them.
    fcs_review_action = 'exclude'

    // Read-level decontamination with kraken2, run before meryl and megahit so both
    // the k-mer profile and the assembly are built from host reads.
    kraken2_db                  = null
    kraken2_confidence          = 0.05
    kraken2_exclude_taxids      = '2 2157 10239' // Bacteria, Archaea, Viruses
    skip_kraken2_decontamination = false

    // MEGAHIT checkpoints live under ${params.outdir}/megahit_checkpoints so a failed
    // assembly can resume, which puts them outside Nextflow's caching. They are
    // fingerprinted on their inputs (bin/megahit_checkpoint_key.sh) so that a change
    // upstream of assembly, kraken2 read filtering for instance, forces a rebuild
    // instead of silently republishing the previous assembly.
    //
    // megahit_checkpoint_unkeyed governs checkpoints written before fingerprinting
    // existed, whose inputs cannot be known:
    //   invalidate - discard and reassemble (default, and the safe reading)
    //   adopt      - claim them for the current inputs, for when you know they match
    megahit_checkpoint_unkeyed  = 'invalidate'

    // megahit_stale_checkpoint governs a checkpoint whose fingerprint no longer matches:
    //   rerun   - discard and reassemble (default)
    //   archive - move aside to <dir>.stale.<timestamp> first, at the cost of the disk
    //   fail    - stop, for a run where a surprise reassembly is worse than a crash
    megahit_stale_checkpoint    = 'rerun'

    // Prune the intermediate assembly graph once a checkpoint is complete. A completed
    // checkpoint can never be continued, so the intermediates are tens of GB per sample
    // of dead weight; removing them leaves the resume-skip path fully working.
    megahit_checkpoint_cleanup  = true

    // Per-class BUSCO lineages. Declared with null defaults so genome_qc can fall back
    // to busco_metazoa_db when a lineage has not been downloaded. There is no
    // echinoderm or sponge lineage in odb12, so those classes stay on metazoa.
    busco_crustacea_db          = null
    busco_mollusca_db           = null
    busco_anthozoa_db           = null
    busco_arthropoda_db         = null
    
    // References
    genome                     = null

    // NCBI taxdump, used to resolve taxon_id/class when the curated `species`
    // table has no row for a sample. Shared storeDir cache with the mitogenome
    // pipeline, which pulls the same dump.
    taxonkit_db_dir            = null

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = null
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')// Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true

    // Location of results for when processes are skipped.
    // These folow the pipeline data structure.
    bs_fastq_glob                               = "${params.outdir}/basespace/${params.run}/*/*.fastq.gz"
    precomputed_download_reads_results          = "${params.outdir}/pooled/${params.run}/*.{R1,R2}.fq.gz"
    precomputed_fastp_fastqc_results            = "${params.outdir}/draftgenomes/*/fastp/*.{R1,R2}.fastq.gz"
    precomputed_fastp_json                      = "${params.outdir}/draftgenomes/*/fastp/*.json"
    precomputed_genome_assembly_results         = "${params.outdir}/draftgenomes/*/assemblies/genome/*mh.fasta"
    precomputed_genomescope_summary             = "${params.outdir}/draftgenomes/*/kmers/*genomescope/*_summary.txt"
    precomputed_coverage_summary                = "${params.outdir}/draftgenomes/*/coverage/*_coverage_summary.json"
    precomputed_genomescope_model               = "${params.outdir}/draftgenomes/*/kmers/*genomescope/*_model.txt"
    precomputed_meryl_hist                      = "${params.outdir}/draftgenomes/*/kmers/*.meryl.hist"
    precomputed_meryl_results                   = "${params.outdir}/draftgenomes/*/kmers/*.meryl"
    precomputed_genome_decontamination_results  = "${params.outdir}/draftgenomes/*/assemblies/genome/*.fna"
    precomputed_filter_report                   = "${params.outdir}/draftgenomes/*/assemblies/genome/NCBI/*filter_report.txt"  
    precomputed_contigs_under_500bp             = "${params.outdir}/draftgenomes/*/assemblies/genome/NCBI/*contig_count_500bp.txt"    
    precomputed_tiara_filter_summary            = "${params.outdir}/draftgenomes/*/assemblies/genome/tiara/*_summary.txt"
    precomputed_genome_qc_results               = "${params.outdir}/draftgenomes/*/assemblies/genome"
    precomputed_busoco_short_summary_results    = "${params.outdir}/draftgenomes/*/assemblies/genome/busco/*short_summary.json"
    precomputed_merqury_results_results         = "${params.outdir}/draftgenomes/*/kmers/*{.stats,merqury.qv}"
    precomputed_gfastats_results_results        = "${params.outdir}/draftgenomes/*/assemblies/genome/gfastats/*assembly_summary"

    // Skip options
    skip_bs_download            = false
    skip_download_reads         = false
    skip_fastp_fastqc           = false
    skip_genome_assembly        = false
    skip_genome_decontamination = false
    skip_genome_qc              = false
    skip_upload_results         = false
}


process {    
    executor = 'slurm'
    // Set shorter job names - this should definitely work
    // clusterOptions = { 
    //     def processName = task.process.tokenize(':').last()
    //     def finalName = task.tag ? "${task.tag}.${processName}" : processName
    //     "--job-name=${finalName.replaceAll('[^a-zA-Z0-9._-]', '_').take(64)}"
    // }
    // Global setting for shorter job names
    clusterOptions = { "--job-name=${task.process.split(':').last()}" }
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        singularity.runOptions = params.binddir ? "-B ${params.binddir}" : ""
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus  : 4,
                time  : 1.h
            ]
        }
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different Institutions
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Load nf-core/oceangenomesdraftgenomes custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/pipeline/oceangenomesdraftgenomes.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options to capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'nf-core/oceangenomesdraftgenomes'
    author          = """Tyler Peirce""" // The author field is deprecated from Nextflow version 24.10.0, use contributors instead
    homePage        = 'https://github.com/nf-core/oceangenomesdraftgenomes'
    description     = """An nf-core pipeline for draft genome assembly, mitogenome assembly and LCA for species validation from Illumina short read data."""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=24.04.2'
    version         = ["git", "-C", "${projectDir}", "describe", "--tags", "--always"].execute().text.trim()
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.2.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
    help {
        enabled = true
        command = "nextflow run nf-core/oceangenomesdraftgenomes -profile <docker/singularity/.../institute> --outdir <OUTDIR>"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
        beforeText = """
-\033[2m----------------------------------------------------\033[0m-
                                        \033[0;32m,--.\033[0;30m/\033[0;32m,-.\033[0m
\033[0;34m        ___     __   __   __   ___     \033[0;32m/,-._.--~\'\033[0m
\033[0;34m  |\\ | |__  __ /  ` /  \\ |__) |__         \033[0;33m}  {\033[0m
\033[0;34m  | \\| |       \\__, \\__/ |  \\ |___     \033[0;32m\\`-._,-`-,\033[0m
                                        \033[0;32m`._,._,\'\033[0m
\033[0;35m  nf-core/oceangenomesdraftgenomes ${manifest.version}\033[0m
-\033[2m----------------------------------------------------\033[0m-
"""
        afterText = """${manifest.doi ? "\n* The pipeline\n" : ""}${manifest.doi.tokenize(",").collect { "    https://doi.org/${it.trim().replace('https://doi.org/','')}"}.join("\n")}${manifest.doi ? "\n" : ""}
* The nf-core framework
    https://doi.org/10.1038/s41587-020-0439-x

* Software dependencies
    https://github.com/nf-core/oceangenomesdraftgenomes/blob/master/CITATIONS.md
"""
    }
    summary {
        beforeText = validation.help.beforeText
        afterText = validation.help.afterText
    }
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'


// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

// Function to ensure that resource requirements don't go beyond
// a maximum limit
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
